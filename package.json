{
  "name": "mah",
  "productName": "MAH",
  "version": "1.0.0",
  "description": "MAH - Missing App Home: quản lý nhà trọ, chung cư mini, ký túc xá, homestay",
  "author": "Missing",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "dependencies": { "@capacitor/android": "^7.0.0", "@capacitor/cli": "^7.0.0", "@capacitor/core": "^7.0.0", "@capacitor/filesystem": "^7.0.0", "@capacitor/ios": "^7.0.0", "@capacitor/share": "^7.0.0" },
  "build": {
    "appId": "vn.missing.mah",
    "productName": "MAH",
    "copyright": "© 2026 Missing. Xem file LICENSE.",
    "files": ["main.js", "app/**/*", "LICENSE"],
    "extraResources": [{ "from": "LICENSE", "to": "LICENSE.txt" }],
    "win": { "target": "nsis", "icon": "app/icon-512.png", "artifactName": "MAH-Windows.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "icon": "app/icon-512.png", "identity": null, "artifactName": "MAH-Mac-${arch}.${ext}" }
  }
}
